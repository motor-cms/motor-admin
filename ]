<?php
use Illuminate\Testing\Fluent\AssertableJson;
use Motor\Admin\Models\Role;
use Motor\Admin\Models\User;
use Motor\Admin\Models\Client;

describe('User', function () {
    it('checks if Avatar is an image', function () {
        $role = Role::where('name', 'SuperAdmin')->first();
        $new_user = [
            'avatar' => [
                'dataUrl' => "QlpoOTFBWSZTWcjFbMkAAAxaAAAQQABoAEAAIAAwwAZoRbpBiJlkcOAvF3JFOFCQyMVsyQ==",
                'name' => "test.pbm",
            ],
            'clients' => [Client::first()->id],
            "email" => "test@test.de",
            "name" => "TestUser",
            "password" => "testtest",
            "roles" => [
                0 => $role->id,
            ]

        ];
        $new_user['avatar'] = [
            'name' => "test.pbm" //actually test.pbm.bz2
        ];
        $response = $this->asAdmin()->post('/api/users', $new_user);
        //$response->assertStatus(500);
    });
    it('can create User', function () {
        $role = Role::where('name', 'SuperAdmin')->first();
        $new_user = [
            'avatar' => [
                'dataUrl' => "UDEKMyAzCjEgMSAxCjAgMSAwCjAgMSAwCg==",
                'name' => "test.pbm",
            ],
            'clients' => [Client::first()->id],
            "email" => "test3@test.de",
            "name" => "TestUser3",
            "password" => "testtest",
            "roles" => [
                0 => $role->id,
            ]

        ];
        $response = $this->asAdmin()->post('/api/users', $new_user);
        $response->assertStatus(201);
    });
    it("can't create Users with invalid clients", function () {
        $this->asAdmin()->post('/api/users', [
            "email" => "test2@test.de",
            "name" => "test2",
            "password" => "awrftwaftawtf",
            "clients" => [0],
        ])->assertStatus(201);
    })->fails();
    it("can get all Users")
        ->asAdmin()
        ->getJson('/api/users')
        ->assertStatus(200)
        ->assertJson(fn (AssertableJson $json) => $json->count('data', 3));

});
