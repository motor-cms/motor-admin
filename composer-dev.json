{
  "name": "motor-cms/motor-admin",
  "description": "Motor admin package",
  "license": "MIT",
  "keywords": [
    "motor"
  ],
  "authors": [
    {
      "name": "Reza Esmaili",
      "email": "me@dfox.info"
    }
  ],
  "repositories": [
  ],
  "require": {
    "php": "^8.4",
    "ext-intl": "*",
    "laravel/sanctum": "^4.0",
    "laravel/scout": "^11.0",
    "spatie/laravel-activitylog": "^5.0",
    "spatie/laravel-collection-macros": "^8.0",
    "spatie/laravel-permission": "^7.0",
    "kalnoy/nestedset": "^7.0",
    "laravel/horizon": "^5.30",
    "olssonm/l5-very-basic-auth": "^7.1",
    "kra8/laravel-snowflake": "^v2.3",
    "wildside/userstamps": "^4.0"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Motor\\Admin\\": "src",
      "Tests\\Motor\\Admin\\": "tests",
      "Motor\\Admin\\Database\\Factories\\": "database/factories/",
      "Motor\\Admin\\Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "helpers/motor_admin_helpers.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Motor\\Admin\\Providers\\MotorServiceProvider",
        "Motor\\Admin\\Providers\\MotorAuthServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
