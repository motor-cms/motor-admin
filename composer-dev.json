{
  "name": "motor-cms/motor-admin",
  "description": "Motor admin package",
  "license": "MIT",
  "keywords": [
    "motor"
  ],
  "authors": [
    {
      "name": "Reza Esmaili",
      "email": "me@dfox.info"
    }
  ],
  "repositories": [
  ],
  "require": {
    "php": "^8.3",
    "laravel/sanctum": "^4.0",
    "laravel/scout": "^10.0",
    "symfony/intl": "^7.1",
    "spatie/laravel-collection-macros": "^7.14",
    "spatie/laravel-permission": "^6.9",
    "kalnoy/nestedset": "^6.0.4",
    "laravel/horizon": "^5.30",
    "olssonm/l5-very-basic-auth": "^7.1",
    "darkaonline/l5-swagger": "^8.6",
    "kra8/laravel-snowflake": "^v2.3",
    "richan-fongdasen/eloquent-blameable": "^1.10"
  },
  "require-dev": {
    "pestphp/pest": "^3.7",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Motor\\Admin\\": "src",
      "Tests\\Motor\\Admin\\": "tests",
      "Motor\\Admin\\Database\\Factories\\": "database/factories/",
      "Motor\\Admin\\Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "helpers/motor_admin_helpers.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Motor\\Admin\\Providers\\MotorServiceProvider",
        "Motor\\Admin\\Providers\\MotorAuthServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
